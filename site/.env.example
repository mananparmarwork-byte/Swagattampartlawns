# Use "/" for a custom domain or user/organization GitHub Pages site.
# Use "/REPOSITORY_NAME/" for a project GitHub Pages site.
VITE_BASE_PATH=/

# Optional: absolute URLs for independently hosted pages.
# If left as /estimator and /admin, those paths must be served by a reverse proxy
# or another host in front of GitHub Pages.
VITE_ESTIMATOR_URL=/estimator
VITE_ADMIN_URL=/admin

# Reserved for a future Supabase-backed feature. Do not use a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=